// Prisma schema for Fake Profile Detection System (FPDS)
// Member 3 — Database Layer

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id             String     @id @default(uuid())
  platform       String
  handle         String
  displayName    String
  bio            String?
  profileUrl     String?
  followers      Int
  following      Int
  postsCount     Int
  accountAgeDays Int
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  analyses       Analysis[]
}

model Analysis {
  id             String   @id @default(uuid())
  profileId      String
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  score          Int
  riskLevel      String
  threatCategory String
  indicators     Json
  breakdown      Json
  createdAt      DateTime @default(now())
}
